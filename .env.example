# Proposed local-only defaults; configuration loader is not implemented yet.
# Server-only configuration: never expose storage credentials in VITE_* variables.
PHOGAEM_STORAGE_DRIVER=local
PHOGAEM_DATA_DIR=.local/phogaem

# No cloud endpoint or credentials are needed for development.
# The existing private Standard bucket is named phogaem-photos.

# Optional frontend server integration. Set only to the disposable gateway
# printed by npm run dev:server when testing locally. No credentials here.
# VITE_MLHOPS_API_BASE=http://127.0.0.1:<printed-port>
